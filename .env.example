# 暖客宝 环境变量示例
# 复制为 .env.local 并填入真实值 (.env.local 不进 git)

# ========== 应用 ==========
NODE_ENV=development
APP_PORT=3003           # 默认 3003, 实测空闲 (避开 sales ai 占用的 3000/3002)
APP_URL=http://localhost:3003

# Dev 模式跳过 Auth.js (手机扫码直看 admin UI, 调试 / 截图 / 验收用)
# 双门闸: NODE_ENV != production && DEV_SKIP_AUTH=1 才生效
# 生产默认关闭 (NODE_ENV=production 会短路), 不小心设到生产也不会爆
DEV_SKIP_AUTH=1

# ========== 数据库 ==========
DATABASE_URL=postgres://nuankebao:nuankebao_password@postgres:5432/nuankebao
PGCRYPTO_KEY=                                  # 32 bytes hex, openssl rand -hex 32 生成
DB_LOG_QUERIES=false                           # 开发期可设 true 看 SQL

# ========== Auth.js ==========
AUTH_SECRET=                                   # openssl rand -base64 32
AUTH_TRUST_HOST=true

# ========== 阿里云短信 (手机号验证码) ==========
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_SECRET_KEY=
ALIYUN_SMS_SIGN_NAME=                          # 短信签名
ALIYUN_SMS_TEMPLATE_CODE=                      # 短信模板 ID

# ========== 端口说明 ==========
# 主人已有 "sales ai" 项目占用 3000, 以及 python3 项目占用 3001, 3002 也被占用
# 暖客宝 实测默认 3003 空闲 (详见 ./tools/check-port.sh)
# - Docker: docker-compose.yml 用 ${APP_PORT:-3003}
# - Dev server: PORT=3003 pnpm dev
# - 验证: ./tools/check-port.sh 3003 (应显示 ✓ 空闲)

# ========== MiniMax AI (Phase 2 启用) ==========
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com     # 国内 endpoint
MINIMAX_MODEL=minimax-text-01

# ========== 对象存储 (图片) ==========
# Phase 2 启用, MVP 阶段图片可存本地 ./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ========== 备份 (dev-domain-backup SOP §3.0) ==========
# 设计: GPG 密钥文件 (passphrase-file, chmod 600) 自动解密, 无需人工介入.
#       密钥文件: /home/tooyan/nuankebao-databackups/backup-key.gpg (脚本自己读)
#       异地盘: /media/tooyan/<盘符>/<盘符>/nuankebao-databackups/ (自动探测, 未挂载会 WARN)
#
# 不需要 .env.local 配 BACKUP_PASSPHRASE (老工具 tools/backup.sh 用过, 已 deprecated).
# 如需重置密钥: openssl rand -base64 32 > /home/tooyan/nuankebao-databackups/backup-key.gpg && chmod 600
#
# GitHub 镜像: 主人 2026-09-08 拍板 skip-github-mirror, 不配 GITHUB_MIRROR_REPO.

# ========== 监控 ==========

# ========== 监控 ==========
# OpenTelemetry endpoint (Phase 2)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ========== 速率限制 (Phase 2) ==========
# Upstash Redis (Phase 2 启用)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=