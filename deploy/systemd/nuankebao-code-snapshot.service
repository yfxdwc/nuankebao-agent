[Unit]
Description=暖客宝 代码快照 (dirty + untracked → 外置盘异地, fail-closed 预检)
Documentation=file:///__PROJECT_DIR__/deploy/README.md
# 错开 nuankebao-backup.service (避免同时跑 rsync 重叠)
After=nuankebao-backup.service
RequiresMountsFor=__OFFSITE_DIR__

[Service]
Type=oneshot
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=%h/.config/nuankebao/paths.conf
Environment="PATH=__USER_LOCAL_BIN__:/usr/local/bin:/usr/bin:/bin"
# 2026-09-19: 同 backup.service, 改用 run-with-log.sh (避免 StandardOutput 目录依赖)
ExecStart=__PROJECT_DIR__/deploy/run-with-log.sh __DATABACKUPS_DIR__/logs/code-snapshot.log __PROJECT_DIR__/deploy/code_snapshot.sh
SuccessExitStatus=0

# 安全加固 (TD-010 A4)
NoNewPrivileges=yes
PrivateTmp=yes

# code snapshot 写区域 (异地盘 + 健康 state + staging)
ReadWritePaths=__OFFSITE_DIR__/nuankebao-codebackups __DATABACKUPS_DIR__ /tmp