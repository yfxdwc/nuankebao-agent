# ============================================
# 暖客宝 生产环境变量 (tc Docker 隔离; P3 部署用)
#
# 用法: cp .env.prod.example .env.prod → 填真实值 → chmod 600 .env.prod
# 生成密钥:
#   POSTGRES_PASSWORD: openssl rand -hex 24
#   AUTH_SECRET:       openssl rand -base64 32
#   PGCRYPTO_KEY:      openssl rand -hex 32
#
# ⚠️ 生产严禁出现 (上线检查项, production-plan §3.B10):
#   DEV_SKIP_AUTH / DEV_LOGIN_ANY_USER / APP_PREVIEW_ENABLED(除特殊情况)
# ============================================

# ---- 应用 ----
NODE_ENV=production
APP_URL=https://nuankebao.tooyang.top
AUTH_URL=https://nuankebao.tooyang.top
AUTH_TRUST_HOST=true
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
PGCRYPTO_KEY=CHANGE_ME_openssl_rand_hex_32
DB_LOG_QUERIES=false

# ---- Postgres (compose 插值 + 容器环境) ----
POSTGRES_USER=nuankebao
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=nuankebao

# ---- 生产 web 绑定端口 (仅 127.0.0.1) ----
# dev 是 3003; prod 用 3004 (tools/check-port.sh 2026-09-19 确认空闲)
PROD_WEB_PORT=3004

# ---- Phase 2 预留 (留空即可) ----
# MINIMAX_API_KEY=
# MINIMAX_API_BASE=https://api.minimaxi.com/anthropic/v1
# MINIMAX_MODEL=
