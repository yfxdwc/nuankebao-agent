[Unit]
Description=NuankeBao Production Stack (Docker Compose, tc 隔离; 2026-09-19 修正)
# Documentation + WorkingDirectory 由 tools/install-guards.sh sed 渲染
Documentation=file://__PROJECT_DIR__/docs/deploy/production-plan.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__PROJECT_DIR__

# 起: 生产 compose (独立 project/容器/卷/端口; dev 不受影响)
ExecStart=/usr/bin/docker compose -p nuankebao-prod -f docker-compose.prod.yml --env-file __PROJECT_DIR__/.env.prod up -d

# 停: 只停生产栈 (保留 named volume); dev 的 next dev / postgres 不动
ExecStop=/usr/bin/docker compose -p nuankebao-prod -f docker-compose.prod.yml --env-file __PROJECT_DIR__/.env.prod down

# 重载: 重新拉起 (配置改了用)
ExecReload=/usr/bin/docker compose -p nuankebao-prod -f docker-compose.prod.yml --env-file __PROJECT_DIR__/.env.prod up -d

# 慢启动容忍 (首次 build / 拉镜像)
TimeoutStartSec=600
TimeoutStopSec=60

# 不自动重启 unit: 容器自身 restart: unless-stopped 负责自愈;
# unit 反复拉起只会在配置错时刷日志 (2026-09-19 失败循环教训)
Restart=no

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
